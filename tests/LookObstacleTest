package za.co.wethinkcode.robots.acceptance;

import org.json.JSONArray;
import org.json.JSONObject;
import org.junit.jupiter.api.*;

import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.PrintWriter;
import java.net.Socket;

import static org.junit.jupiter.api.Assertions.*;

/**
 * Acceptance tests for STORY: Look — Iteration 2 scenarios.
 *
 * Requires a server running with a 2x2 world and an obstacle at [0,1]:
 *   java -jar target/robot-world-1.0-SNAPSHOT.jar -p 5052 -s 2 -o 0,1
 *
 * Run with:
 *   mvn test -Dtest=LookObstacleTests -Dacceptance.excludedGroups= -Dserver.port=5052
 */
@Tag("acceptance")
public class LookObstacleTests {

    private static final String DEFAULT_IP = "localhost";
    private static final int DEFAULT_PORT =
            Integer.parseInt(System.getProperty("server.port", "5052"));

    private Socket socket;
    private BufferedReader in;
    private PrintWriter out;

    @BeforeEach
    void connectToServer() throws Exception {
        socket = new Socket(DEFAULT_IP, DEFAULT_PORT);
        in = new BufferedReader(new InputStreamReader(socket.getInputStream()));
        out = new PrintWriter(socket.getOutputStream(), true);
    }

    @AfterEach
    void disconnectFromServer() throws Exception {
        if (socket != null && !socket.isClosed()) {
            socket.close();
        }
    }

    private JSONObject sendRequest(JSONObject request) throws Exception {
        out.println(request.toString());
        String responseLine = in.readLine();
        return new JSONObject(responseLine);
    }

    private JSONObject launchRobot(String name) throws Exception {
        JSONObject request = new JSONObject();
        request.put("robot", name);
        request.put("command", "launch");
        request.put("arguments", new JSONArray(new String[]{"shooter", "5", "5"}));
        return sendRequest(request);
    }

    private JSONObject lookWith(String name) throws Exception {
        JSONObject request = new JSONObject();
        request.put("robot", name);
        request.put("command", "look");
        request.put("arguments", new JSONArray());
        return sendRequest(request);
    }

    /**
     * Scenario: See an obstacle
     *
     * Given a world of size 2x2
     * and the world has an obstacle at coordinate [0,1]
     * and I have successfully launched a robot into the world
     * When I ask the robot to look
     * Then I should get a response back with an object of type OBSTACLE
     * at a distance of 1 step.
     */
    @Test
    void seesObstacleOneStepAway() throws Exception {
        JSONObject launchResponse = launchRobot("OBSTACLE_LOOKER");
        assertEquals("OK", launchResponse.getString("result"),
                "robot should launch successfully into the 2x2 world");

        JSONObject response = lookWith("OBSTACLE_LOOKER");
        assertEquals("OK", response.getString("result"));

        JSONArray objects = response.getJSONObject("data").getJSONArray("objects");

        boolean sawObstacleOneStepAway = false;
        for (int i = 0; i < objects.length(); i++) {
            JSONObject obj = objects.getJSONObject(i);
            if ("OBSTACLE".equals(obj.getString("type")) && obj.getInt("distance") == 1) {
                sawObstacleOneStepAway = true;
                break;
            }
        }

        assertTrue(sawObstacleOneStepAway,
                "expected an OBSTACLE one step away, got: " + objects);
    }

    /**
     * Scenario: See robots and obstacles
     *
     * Given a world of size 2x2
     * and the world has an obstacle at coordinate [0,1]
     * and I have successfully launched 8 robots into the world
     * When I ask the first robot to look
     * Then I should get a response back with
     * one object being an OBSTACLE that is one step away
     * and three objects should be ROBOTs that is one step away
     */
    @Test
    void seesRobotsAndObstacleAroundFullGrid() throws Exception {
        JSONObject firstLaunch = launchRobot("FIRST_ROBOT");
        assertEquals("OK", firstLaunch.getString("result"),
                "first robot should launch successfully");

        // 2x2 world has 9 cells total; one is the obstacle, so 8 remain for robots.
        // Launch the remaining 7 robots to fill the grid.
        for (int i = 1; i <= 7; i++) {
            JSONObject launchResponse = launchRobot("ROBOT_" + i);
            assertEquals("OK", launchResponse.getString("result"),
                    "robot " + i + " should launch successfully");
        }

        JSONObject response = lookWith("FIRST_ROBOT");
        assertEquals("OK", response.getString("result"));

        JSONArray objects = response.getJSONObject("data").getJSONArray("objects");

        long obstacleCountOneStep = 0;
        long robotCountOneStep = 0;

        for (int i = 0; i < objects.length(); i++) {
            JSONObject obj = objects.getJSONObject(i);
            if (obj.getInt("distance") == 1) {
                if ("OBSTACLE".equals(obj.getString("type"))) obstacleCountOneStep++;
                if ("ROBOT".equals(obj.getString("type"))) robotCountOneStep++;
            }
        }

        assertEquals(1, obstacleCountOneStep,
                "expected exactly one OBSTACLE one step away, got: " + objects);
        assertEquals(3, robotCountOneStep,
                "expected exactly three ROBOTs one step away, got: " + objects);
    }
}
